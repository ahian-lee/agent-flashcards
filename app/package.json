{
  "name": "agent-flashcards",
  "private": true,
  "version": "1.0.0",
  "description": "移动优先的 Agent 知识闪卡 PWA：FSRS 间隔重复、可离线、进度只存本机",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sync-content.mjs && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "sync:content": "node scripts/sync-content.mjs",
    "gen:icons": "node scripts/gen-icons.mjs",
    "check:content": "node scripts/sync-content.mjs",
    "smoke": "node scripts/smoke-preview.mjs"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.88.0",
    "playwright-core": "^1.64.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
